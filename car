import os
import requests
from bs4 import BeautifulSoup

def send_notification(message):
    """
    DiscordやLINE、SlackなどのWebhookに通知を送る関数
    例として環境変数に設定した WEBHOOK_URL を使用します
    """
    webhook_url = os.environ.get("WEBHOOK_URL")
    if not webhook_url:
        print("通知URLが設定されていません。コンソール出力のみ行います。")
        print(message)
        return

    # Discord等の場合の一例
    payload = {"content": message}
    requests.post(webhook_url, json=payload)

def search_swift_sport():
    url = "https://www.carsensor.net/usedcar/bSU/s018/f001/m004/g002/index.html"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36"
    }
    params = {
        "STID": "CS210610",
        "PREF": "22,23",     # 静岡県、愛知県
        "TR": "M",          # MT車
        "MAX_MAX_S": "39",  # 3.9万km以下
    }

    try:
        response = requests.get(url, headers=headers, params=params)
        response.raise_for_status()
        response.encoding = response.apparent_encoding

        soup = BeautifulSoup(response.text, "html.parser")
        cassettes = soup.find_all("div", class_="cassetteMain")

        if not cassettes:
            print("条件に一致する車両が見つかりませんでした。")
            return

        results = []
        for item in cassettes:
            title_tag = item.find("h3", class_="cassetteMain__title")
            title = title_tag.text.strip() if title_tag else "名称不明"

            price_tag = item.find("span", class_="cassetteMain__priceNum")
            price = price_tag.text.strip() + "万円" if price_tag else "応相談"

            spec_tags = item.find_all("li", class_="cassetteMain__specItem")
            year = spec_tags[0].text.strip() if len(spec_tags) > 0 else "-"
            distance = spec_tags[1].text.strip() if len(spec_tags) > 1 else "-"

            shop_tag = item.find("p", class_="cassetteMain__shopName")
            shop = shop_tag.text.strip() if shop_tag else "店舗不明"

            link_tag = item.find("a")
            link = "https://www.carsensor.net" + link_tag["href"] if link_tag else ""

            results.append(f"🚗 【新着候補】 {title}\n💰 価格: {price} | 📅 年式/距離: {year} / {distance}\n🏠 店舗: {shop}\n🔗 {link}\n")

        # まとめて通知
        if results:
            message = f"【スイフトスポーツ(ZC33S) 自動検索結果】({len(results)}件)\n\n" + "\n".join(results)
            send_notification(message)

    except Exception as e:
        print(f"エラーが発生しました: {e}")

if __name__ == "__main__":
    search_swift_sport()
